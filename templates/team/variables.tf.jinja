# Variables for team module (single-state mode)
# These are passed from the root module to avoid redundant API calls

variable "permission_sets_map" {
  description = "Map of permission set names to their ARNs (passed from permission_sets module)"
  type        = map(string)
  default     = {}
}

variable "users_map" {
  description = "Map of user names to their Identity Store user IDs (passed from identity_store module)"
  type        = map(string)
  default     = {}
}

variable "groups_map" {
  description = "Map of group names to their Identity Store group IDs (passed from identity_store module)"
  type        = map(string)
  default     = {}
}
